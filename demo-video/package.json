{
  "name": "socia-demo-video",
  "version": "0.1.0",
  "private": true,
  "description": "30s SOCIA product demo — Playwright captures of the live app composited with Remotion.",
  "scripts": {
    "capture": "tsx capture.ts",
    "stills": "tsx capture.ts --stills-only",
    "render:method": "remotion render src/method/index.ts SociaMethod out/socia-method.mp4",
    "render:agent": "remotion render src/agent/index.ts SociaAgent out/socia-agent.mp4",
    "render:claude-connect": "remotion render src/claude-connect/index.ts ClaudeConnect out/claude-connect.mp4",
    "render:three-tools": "remotion render src/three-tools/index.ts ThreeTools out/three-tools.mp4",
    "render:eight-blocks": "remotion render src/eight-blocks/index.ts EightBlocks out/eight-blocks.mp4",
    "render": "remotion render src/index.ts SociaDemoVertical out/socia-demo-vertical.mp4 && remotion render src/index.ts SociaDemoWide out/socia-demo-wide.mp4",
    "verify": "tsx verify.ts",
    "studio": "remotion studio src/index.ts",
    "render:daily-2026-11-01-pm": "remotion render src/daily-2026-11-01-pm/index.ts Daily20261101PM out/daily-2026-11-01-pm.mp4",
    "render:daily-2026-11-02-am": "remotion render src/daily-2026-11-02-am/index.ts Daily20261102AM out/daily-2026-11-02-am.mp4",
    "render:daily-2026-11-02-pm": "remotion render src/daily-2026-11-02-pm/index.ts Daily20261102PM out/daily-2026-11-02-pm.mp4",
    "render:one-connector": "remotion render src/one-connector/index.ts OneConnector out/one-connector.mp4",
    "render:launch-calendar": "remotion render src/launch-calendar/index.ts LaunchCalendar out/launch-calendar.mp4",
    "render:connector-reel": "remotion render src/connector-reel/index.ts ConnectorReel out/connector-reel.mp4",
    "render:laptop-connect": "remotion render src/laptop-connect/index.ts LaptopConnect out/laptop-connect.mp4",
    "render:same-reel": "remotion render src/same-reel/index.ts SameReel out/same-reel.mp4",
    "render:cal-1101-best-time": "remotion render src/cal-1101-best-time/index.ts Cal1101BestTime out/cal-1101-best-time.mp4",
    "render:cal-1102-drop-handle": "remotion render src/cal-1102-drop-handle/index.ts Cal1102DropHandle out/cal-1102-drop-handle.mp4",
    "render:cal-1102-flop-tutorial": "remotion render src/cal-1102-flop-tutorial/index.ts Cal1102FlopTutorial out/cal-1102-flop-tutorial.mp4",
    "render:cal-1103-first-thing": "remotion render src/cal-1103-first-thing/index.ts Cal1103FirstThing out/cal-1103-first-thing.mp4",
    "render:cal-1104-plan-prompt": "remotion render src/cal-1104-plan-prompt/index.ts Cal1104PlanPrompt out/cal-1104-plan-prompt.mp4",
    "render:cal-1104-saves": "remotion render src/cal-1104-saves/index.ts Cal1104Saves out/cal-1104-saves.mp4",
    "render:cal-1104-week-plan": "remotion render src/cal-1104-week-plan/index.ts Cal1104WeekPlan out/cal-1104-week-plan.mp4",
    "render:cal-1105-flop-surprise": "remotion render src/cal-1105-flop-surprise/index.ts Cal1105FlopSurprise out/cal-1105-flop-surprise.mp4",
    "render:cal-1106-caption-rewrite": "remotion render src/cal-1106-caption-rewrite/index.ts Cal1106CaptionRewrite out/cal-1106-caption-rewrite.mp4",
    "render:cal-1106-three-hooks": "remotion render src/cal-1106-three-hooks/index.ts Cal1106ThreeHooks out/cal-1106-three-hooks.mp4",
    "render:cal-1107-competitors": "remotion render src/cal-1107-competitors/index.ts Cal1107Competitors out/cal-1107-competitors.mp4",
    "render:cal-1107-why-built": "remotion render src/cal-1107-why-built/index.ts Cal1107WhyBuilt out/cal-1107-why-built.mp4",
    "render:cal-1108-calendar": "remotion render src/cal-1108-calendar/index.ts Cal1108Calendar out/cal-1108-calendar.mp4",
