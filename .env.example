# Copy to .env.local and fill in.
# Your Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Supabase — from your project's Settings → API page.
# Safe to expose to the browser (the anon key is limited by your RLS policies).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Never exposed to the browser. Used by the scheduled-post
# publisher (cron mode) and by plan enforcement writes that must bypass RLS:
# adding a competitor within the plan cap and applying a downgrade's
# "choose what to keep" decision. Without it those two actions answer 503.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the pg_cron jobs send as a Bearer token to /api/schedule/publish
# and /api/sync/daily.
CRON_SECRET=

# Optional. Public address used on /pricing and Settings for "contact us" until
# checkout is wired. Defaults to the address on the privacy and terms pages.
# NEXT_PUBLIC_SUPPORT_EMAIL=

# TikTok (Login Kit + Content Posting API). From TikTok for Developers → your
# app → Credentials. The Sandbox has its own key/secret; use those until the
# app passes review. Redirect URI registered on the app must be exactly
# <NEXT_PUBLIC_APP_URL>/api/auth/tiktok/callback. Run supabase/tiktok-connections.sql.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Stripe billing (lib/stripe.ts). Test-mode values first; live values at launch.
# Products and Prices are created in the Stripe Dashboard; paste the price ids here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
